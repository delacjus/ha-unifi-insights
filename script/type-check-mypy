#!/bin/bash

# script/type-check-mypy: Run mypy with canonical Home Assistant environment
#
# Runs mypy with project strict settings and installed Home Assistant dependencies.
# Used by pre-commit and manual type checking.
#
# Usage:
#   ./script/type-check-mypy [FILES...]
#
# Examples:
#   ./script/type-check-mypy
#   ./script/type-check-mypy custom_components/unifi_insights/sensor.py

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_DIR"

# shellcheck source=script/.lib/output.sh
source "$SCRIPT_DIR/.lib/output.sh"

if [[ -z ${VIRTUAL_ENV:-} ]]; then
    if [[ -f "$REPO_DIR/.local/ha-venv/bin/activate" ]]; then
        source "$REPO_DIR/.local/ha-venv/bin/activate"
    elif [[ -f "$HOME/.local/ha-venv/bin/activate" ]]; then
        source "$HOME/.local/ha-venv/bin/activate"
    else
        log_error "Virtual environment not found in $REPO_DIR/.local/ha-venv or $HOME/.local/ha-venv"
        log_info "Run: ./script/setup/bootstrap"
        exit 1
    fi
fi

if ! command -v mypy >/dev/null 2>&1; then
    log_error "mypy not found. Please activate the virtual environment or run ./script/setup/bootstrap"
    exit 1
fi

if [[ $# -eq 0 ]]; then
    exec mypy custom_components/unifi_insights
else
    exec mypy "$@"
fi
